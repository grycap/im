upgrade front_upgrade (
@begin
---
- pre_tasks:
    - name: Allow Kubernetes packages to be upgraded
      dpkg_selections:
        name: "{{ item }}"
        selection: install
      loop:
        - kubeadm
        - kubelet
        - kubectl
  tasks:
    - name: Add target Kubernetes repository key
      get_url:
        url: "https://pkgs.k8s.io/core:/stable:/v{{ '__TARGET_VERSION__'.split('.')[0] }}.{{ '__TARGET_VERSION__'.split('.')[1] }}/deb/Release.key"
        dest: /etc/apt/trusted.gpg.d/kubernetes.asc
        mode: '0644'
    - name: Add target Kubernetes repository
      apt_repository:
        repo: "deb https://pkgs.k8s.io/core:/stable:/v{{ '__TARGET_VERSION__'.split('.')[0] }}.{{ '__TARGET_VERSION__'.split('.')[1] }}/deb/ /"
        state: present
        update_cache: yes
    - name: Install target kubeadm version on the control plane
      apt:
        name: "kubeadm=__TARGET_VERSION__*"
        state: present
        update_cache: yes
    - name: Read current Kubernetes API version
      command: kubectl version --output=json
      register: api_version
      changed_when: false
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
    - name: Check Kubernetes control-plane upgrade plan
      command: kubeadm upgrade plan
      when: (api_version.stdout | from_json).serverVersion.gitVersion != 'v__TARGET_VERSION__'
    - name: Upgrade Kubernetes control plane
      command: kubeadm upgrade apply v__TARGET_VERSION__ --yes
      when: (api_version.stdout | from_json).serverVersion.gitVersion != 'v__TARGET_VERSION__'
    - name: Read control-plane kubelet version
      command: kubectl get node {{ ansible_fqdn }} -o jsonpath={.status.nodeInfo.kubeletVersion}
      register: kubelet_version
      changed_when: false
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
    - name: Upgrade control-plane kubelet
      block:
        - name: Drain control-plane node
          command: kubectl drain {{ ansible_fqdn }} --ignore-daemonsets --delete-emptydir-data --timeout=10m
          environment:
            KUBECONFIG: /etc/kubernetes/admin.conf
        - name: Install target kubelet and kubectl versions
          apt:
            name:
              - "kubelet=__TARGET_VERSION__*"
              - "kubectl=__TARGET_VERSION__*"
            state: present
            update_cache: yes
        - name: Reload systemd after kubelet package upgrade
          systemd:
            daemon_reload: yes
        - name: Restart kubelet
          service:
            name: kubelet
            state: restarted
      always:
        - name: Uncordon control-plane node
          command: kubectl uncordon {{ ansible_fqdn }}
          environment:
            KUBECONFIG: /etc/kubernetes/admin.conf
      when: kubelet_version.stdout != 'v__TARGET_VERSION__'
  post_tasks:
    - name: Hold Kubernetes packages after upgrade
      dpkg_selections:
        name: "{{ item }}"
        selection: hold
      loop:
        - kubeadm
        - kubelet
        - kubectl
@end
)

upgrade wn_upgrade (
@begin
---
- vars:
    kube_server: kubeserver
  pre_tasks:
    - name: Allow Kubernetes packages to be upgraded
      dpkg_selections:
        name: "{{ item }}"
        selection: install
      loop:
        - kubeadm
        - kubelet
        - kubectl
  tasks:
    - name: Add target Kubernetes repository key
      get_url:
        url: "https://pkgs.k8s.io/core:/stable:/v{{ '__TARGET_VERSION__'.split('.')[0] }}.{{ '__TARGET_VERSION__'.split('.')[1] }}/deb/Release.key"
        dest: /etc/apt/trusted.gpg.d/kubernetes.asc
        mode: '0644'
    - name: Add target Kubernetes repository
      apt_repository:
        repo: "deb https://pkgs.k8s.io/core:/stable:/v{{ '__TARGET_VERSION__'.split('.')[0] }}.{{ '__TARGET_VERSION__'.split('.')[1] }}/deb/ /"
        state: present
        update_cache: yes
    - name: Wait for control plane to reach target version
      command: kubectl version --output=json
      delegate_to: "{{ kube_server }}"
      register: api_version
      changed_when: false
      retries: 270
      delay: 10
      until: (api_version.stdout | from_json).serverVersion.gitVersion == 'v__TARGET_VERSION__'
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
    - name: Read worker kubelet version from the control plane
      command: kubectl get node {{ hostvars[inventory_hostname].ansible_fqdn }} -o jsonpath={.status.nodeInfo.kubeletVersion}
      delegate_to: "{{ kube_server }}"
      register: kubelet_version
      changed_when: false
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
    - name: Upgrade worker node
      block:
        - name: Install target kubeadm and kubectl versions
          apt:
            name:
              - "kubeadm=__TARGET_VERSION__*"
              - "kubectl=__TARGET_VERSION__*"
            state: present
            update_cache: yes
        - name: Apply kubeadm worker-node upgrade
          command: kubeadm upgrade node
        - name: Drain worker node
          command: kubectl drain {{ hostvars[inventory_hostname].ansible_fqdn }} --ignore-daemonsets --delete-emptydir-data --timeout=10m
          delegate_to: "{{ kube_server }}"
          environment:
            KUBECONFIG: /etc/kubernetes/admin.conf
        - name: Install target kubelet version
          apt:
            name: "kubelet=__TARGET_VERSION__*"
            state: present
            update_cache: yes
        - name: Reload systemd after kubelet package upgrade
          systemd:
            daemon_reload: yes
        - name: Restart kubelet
          service:
            name: kubelet
            state: restarted
      always:
        - name: Uncordon worker node
          command: kubectl uncordon {{ hostvars[inventory_hostname].ansible_fqdn }}
          delegate_to: "{{ kube_server }}"
          environment:
            KUBECONFIG: /etc/kubernetes/admin.conf
      when: kubelet_version.stdout != 'v__TARGET_VERSION__'
  post_tasks:
    - name: Hold Kubernetes packages after upgrade
      dpkg_selections:
        name: "{{ item }}"
        selection: hold
      loop:
        - kubeadm
        - kubelet
        - kubectl
@end
)

upgrade verify_cluster (
@begin
---
- tasks:
    - name: Read Kubernetes nodes and their kubelet versions
      command: kubectl get nodes -o json
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
      register: kubernetes_nodes
      changed_when: false
    - name: Assert that the frontend and worker are both on the target version
      assert:
        that:
          - item.status.nodeInfo.kubeletVersion == 'v__TARGET_VERSION__'
          - "item.status.conditions | selectattr('type', 'equalto', 'Ready') | selectattr('status', 'equalto', 'True') | list | length > 0"
        fail_msg: "Node {{ item.metadata.name }} has not reached Kubernetes __TARGET_VERSION__ and Ready status"
      loop: "{{ (kubernetes_nodes.stdout | from_json)['items'] }}"
      loop_control:
        label: "{{ item.metadata.name }}"
    - name: Assert that exactly two cluster nodes were verified
      assert:
        that: (kubernetes_nodes.stdout | from_json)['items'] | length == 2
    - name: Mark the complete cluster upgrade as verified
      debug:
        msg: K8S_UPGRADE_ALL_NODES_VERIFIED___TARGET_VERSION_UNDERSCORES__
@end
)

contextualize 5400 (
  system front upgrade front_upgrade step 1
  system wn upgrade wn_upgrade step 2 sequential
  system front upgrade verify_cluster step 3
)
